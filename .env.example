# Copy to .env and fill in. Never commit .env.
ANTHROPIC_API_KEY=sk-ant-...

# Model used for suggestion generation.
TALKER_MODEL=claude-opus-5

# low | medium | high  — "low" is the right default here: suggestion generation is
# a fast structured task, and latency is the core UX constraint in AAC.
TALKER_EFFORT=low

PORT=3000
